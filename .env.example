# ---------------------------------------------------------------------------
# Set these as Environment Variables in your Vercel project settings.
# This file is a reference only — do not commit real values.
# ---------------------------------------------------------------------------

# Neon Postgres — POOLED connection (used by the app at runtime).
# On Neon this is the hostname containing "-pooler".
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"

# Neon Postgres — DIRECT / non-pooled (used by prisma db push at build time).
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Session signing key. Minimum 32 characters. The app refuses to start without
# it. Use any password generator, or Vercel's "Generate Secret" button.
JWT_SECRET=""

# Your admin account, created automatically on first deploy.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"

# Your first-login password, minimum 8 characters. You will be forced to
# change it immediately, so this value stops working after that.
# If you leave it blank, one is generated and printed in the Vercel build log.
ADMIN_PASSWORD=""

# Lockout recovery only. Set to "true", redeploy, sign in with the new
# ADMIN_PASSWORD, then DELETE this variable. Leaving it set means every deploy
# resets your password.
# ADMIN_PASSWORD_RESET="true"

# Optional. Defaults to Asia/Kuwait.
# NEXT_PUBLIC_APP_TIMEZONE="Asia/Kuwait"
