# Neon Postgres — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"

# Neon Postgres — non-pooled/direct (used by prisma db push & migrations)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# Session signing key. Generate yourself, min 32 chars:
#   openssl rand -base64 48
JWT_SECRET=""

# Seed admin account. Change the password after first login.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD=""
