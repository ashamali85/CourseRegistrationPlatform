generator client {
  provider = "prisma-client-js"
}

// PostgreSQL on Neon. DATABASE_URL = pooled; DIRECT_URL = non-pooled (used by
// prisma db push / migrations).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Anyone who logs in.
//   ADMIN   -> you. Manages courses, availability, and sees every booking.
//   STUDENT -> registers themselves, books slots.
// Role is stored as a string and validated by zod at the app layer.
// SECURITY: role is NEVER accepted from a form. Self-registration always
// forces STUDENT; only the seed script creates an ADMIN.
// ---------------------------------------------------------------------------
model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String  @default("STUDENT")
  isActive     Boolean @default(true)

  // Set on seeded/reset accounts. While true the app refuses every page and
  // every action except the password change itself.
  mustChangePassword Boolean @default(false)

  // Any session token issued before this instant is rejected, so changing a
  // password signs out every other device. Truncated to whole seconds because
  // the JWT `iat` claim has second granularity.
  passwordChangedAt DateTime @default(now())

  // Null until the address is confirmed by clicking the emailed link.
  // Unverified accounts can sign in and browse but cannot book.
  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings           Booking[]
  auditLogs          AuditLog[]
  verificationTokens EmailVerificationToken[]
}

// ---------------------------------------------------------------------------
// A single-use link emailed to confirm an address.
//
// Only the SHA-256 of the token is stored. The raw value exists in the email
// and nowhere else, so a leaked database dump cannot be used to verify
// somebody else's address.
// ---------------------------------------------------------------------------
model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// A course you offer. Students only ever see isPublished = true.
// ---------------------------------------------------------------------------
model Course {
  id          String  @id @default(cuid())
  title       String
  summary     String  @default("")
  description String  @default("")
  isPublished Boolean @default(false)

  // Default session length in hours: 1, 2 or 3. Enforced by zod, and used as
  // the pre-selected duration when adding a time slot. Each slot still stores
  // its own start/end, so a single day can deviate if you need it to.
  sessionHours Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days     CourseDay[]
  bookings Booking[]

  @@index([isPublished])
}

// ---------------------------------------------------------------------------
// One calendar date on which a course runs. The admin picks these first — as a
// consecutive range or as individual days — and then fills in the times for
// each one, so Sunday's schedule can differ from Monday's.
//
// `date` is a pure date KEY, stored as midnight UTC of the literal YYYY-MM-DD.
// It is never timezone-converted, because shifting a date key by an offset is
// how days silently drift by one. Real instants live on AvailabilitySlot.
// ---------------------------------------------------------------------------
model CourseDay {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date     DateTime

  createdAt DateTime @default(now())

  slots AvailabilitySlot[]

  @@unique([courseId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// A teaching window on a specific CourseDay.
//
// capacity is how many students may book it (1 = one-to-one).
//
// Slots are course-scoped now, but there is still only ONE of you, so slot
// creation checks for overlap across EVERY course — not just this one.
// Without that check two courses could both be scheduled for 10:00 Tuesday.
// ---------------------------------------------------------------------------
model AvailabilitySlot {
  id       String   @id @default(cuid())
  startsAt DateTime
  endsAt   DateTime
  capacity Int      @default(1)
  note     String   @default("")

  courseDayId String
  courseDay   CourseDay @relation(fields: [courseDayId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([startsAt])
  @@index([courseDayId])
}

// ---------------------------------------------------------------------------
// A student holding a seat in a slot for a course.
//
// @@unique([slotId, userId]) stops the same student booking one slot twice.
// Capacity across different students is enforced inside a Serializable
// transaction in lib/actions/booking-actions.ts — a count check alone would
// race under concurrent requests.
// ---------------------------------------------------------------------------
model Booking {
  id        String @id @default(cuid())
  reference String @unique

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slotId   String
  slot     AvailabilitySlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  // CONFIRMED | CANCELLED
  status      String    @default("CONFIRMED")
  notes       String    @default("")
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@unique([slotId, userId])
  @@index([slotId, status])
  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// Sequential human-facing reference numbers (BK-000001).
// ---------------------------------------------------------------------------
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Every mutation is recorded here.
// ---------------------------------------------------------------------------
model AuditLog {
  id          String  @id @default(cuid())
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  entityType String
  entityId   String?
  entityName String?
  details    String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
